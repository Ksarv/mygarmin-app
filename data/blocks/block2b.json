  ],
  "continues": [
    "bridge3"
  ],
  "schedule_note": "Пн–Пт: ранок і вечір — довгі заняття, обід — до 30 хв. Субота — лише після обіду. Неділя — весь день.",
  "rationale": [
    {
      "what": "Час не обмежує — обмежує відновлення",
      "why": "Важких занять лише чотири: три силові (пн, ср, пт) і інтервали (сб). Усе інше — легке: аеробна база, рухливість, короткі вправи в обід. Важкий день чергується з легким, тож тіло встигає адаптуватися."
    },
    {
      "what": "Три силові заняття з різним акцентом",
      "why": "A — присід, румунська тяга, підтягування, плечі на блоці. B — одна нога, бруси, тяга сидячи, гіперекстензія. C — спритність і потужність: човниковий біг, стрибки, скакалка, бічні рухи. Кожне — на все тіло, з колами й короткими переходами."
    },
    {
      "what": "Обладнання залу — у програмі",
      "why": "Тяга каната до обличчя (верхній блок) замість Y-підйомів — плечі й постава з вагою, яку можна додавати. Тяга нижнього блока сидячи — стабільна горизонтальна тяга. Гіперекстензія на лаві 45° — нахил від таза з опорою, школа для румунської тяги. Згинання на лаві Скотта — лікті й біцепси для підтягувань. Човниковий біг 10 м у п’ятницю — розгін, гальмування й розвороти замість тривалого бігу. Куб для стрибків — у занятті C: стрибок на куб після підтягувань, поки ноги свіжі; бічні стрибки з утриманням перейшли в атлетичне коло."
    },
    {
      "what": "Підтягування двічі на тиждень, бруси — раз",
      "why": "Сухожилля ліктів і плечей звикають до навантаження повільніше за м’язи. Стрибок і повільне опускання в понеділок і п’ятницю, бруси в середу."
    },
    {
      "what": "Аеробна база — орбітрек у розмовному темпі",
      "why": "Вівторок і четвер зранку, довге заняття в неділю: 30 / 30 / 40 хв → 40 / 40 / 60 хв за три тижні. Інтервали в суботу — для сноуборду й танців. Бігати поки не можна; ця база разом із литками й скакалкою підготує до бігу."
    },
    {
      "what": "Гнучкість — щодня потроху й двічі по-справжньому",
      "why": "Обов’язкові заняття в четвер і неділю, необов’язкове — у вівторок, плюс ранки по 8–12 хв (два готові комплекси Garmin і один наш). Акцент на стегнах (танці, сноуборд, секс), задній поверхні, хребті й плечах."
    },
    {
      "what": "Обід — 11–16 хв без поту, необов’язково",
      "why": "Пн / ср / пт — постава й баланс стоячи (стіна, двері). Вт / чт — корпус на килимку. Найпростіший спосіб рухатися щодня після сидіння."
    },
    {
      "what": "Хвиля навантаження",
      "why": "Тиждень 4 — вступний (у великих колах 2 кола замість 3, атлетичне — 3 замість 4). Тижні 5–6 — повний обсяг. Тиждень 7 — розвантаження: силова частина й інтервали приблизно на третину менші, щоб тіло закріпило адаптацію перед блоком 3."
    },
    {
      "what": "Ваги для кожної вправи окремо",
      "why": "Розбірні гантелі до 15 кг, гексагональні від 12,5 кг, крок 2,5 кг. Гоблет, румунська тяга — 15 кг; односторонні вправи — 12,5 кг. На блоці — орієнтир 30 кг (тяги), 10 кг (канат до обличчя). EZ-гриф і перший підхід на новому тренажері — підбери вагу з 2–3 повтореннями в запасі й запиши."
    },
    {
      "what": "Відновлення — частина програми",
      "why": "Сон 7–8 годин і білок у кожному прийомі їжі. Неділя легка навмисно. Якщо щось болить гостро — пропусти вправу й напиши в коментарі; правила притримають дозування."
    }
  ],
